// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider      = "prisma-client-js"
    binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id            String    @id @default(cuid())
    email         String    @unique
    password      String
    firstName     String
    lastName      String
    phoneNumber   String?
    countryCode   String    @default("GH")
    kycStatus     KycStatus @default(PENDING)
    isActive      Boolean   @default(true)
    emailVerified Boolean   @default(false)
    phoneVerified Boolean   @default(false)
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
    lastLoginAt   DateTime?

    // Relations
    accounts    Account[]
    remittances Remittance[]
    auditLogs   AuditLog[]

    @@map("users")
}

model Account {
    id          String        @id @default(cuid())
    userId      String
    accountType AccountType   @default(PERSONAL)
    currency    String        @default("GHS")
    balance     Decimal       @default(0) @db.Decimal(15, 2)
    status      AccountStatus @default(ACTIVE)
    createdAt   DateTime      @default(now())
    updatedAt   DateTime      @updatedAt

    // Relations
    user                    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
    sentRemittances         Remittance[]     @relation("SenderAccount")
    receivedRemittances     Remittance[]     @relation("ReceiverAccount")
    debitTransactions       Transaction[]    @relation("DebitAccount")
    creditTransactions      Transaction[]    @relation("CreditAccount")

    @@map("accounts")
}

model Remittance {
    id                String           @id @default(cuid())
    idempotencyKey    String           @unique
    senderAccountId   String
    receiverAccountId String?
    receiverDetails   Json // Store receiver info for cross-border
    amount            Decimal          @db.Decimal(15, 2)
    currency          String
    exchangeRate      Decimal?         @db.Decimal(10, 6)
    convertedAmount   Decimal?         @db.Decimal(15, 2)
    convertedCurrency String?
    fee               Decimal          @db.Decimal(15, 2)
    status            RemittanceStatus @default(PENDING)
    paymentProvider   String?
    providerTxnId     String?
    failureReason     String?
    metadata          Json?
    createdAt         DateTime         @default(now())
    updatedAt         DateTime         @updatedAt
    completedAt       DateTime?

    // Relations
    senderAccount   Account       @relation("SenderAccount", fields: [senderAccountId], references: [id], map: "fk_remittance_senderAccountId")
    receiverAccount Account?      @relation("ReceiverAccount", fields: [receiverAccountId], references: [id])
    user            User          @relation(fields: [senderAccountId], references: [id], map: "fk_remittance_user_senderAccountId")
    auditLogs       AuditLog[]
    transactions    Transaction[]

    @@map("remittances")
}

model AuditLog {
    id           String   @id @default(cuid())
    userId       String?
    remittanceId String?
    action       String
    resource     String
    details      Json
    ipAddress    String?
    userAgent    String?
    createdAt    DateTime @default(now())

    // Relations
    user       User?       @relation(fields: [userId], references: [id])
    remittance Remittance? @relation(fields: [remittanceId], references: [id])

    @@map("audit_logs")
}

model ApiKey {
    id          String    @id @default(cuid())
    name        String
    keyHash     String    @unique
    permissions Json // Array of permissions
    isActive    Boolean   @default(true)
    lastUsedAt  DateTime?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    expiresAt   DateTime?

    @@map("api_keys")
}

model ExchangeRate {
    id           String   @id @default(cuid())
    fromCurrency String
    toCurrency   String
    rate         Decimal  @db.Decimal(10, 6)
    provider     String
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    @@unique([fromCurrency, toCurrency])
    @@map("exchange_rates")
}

model Transaction {
    id              String            @id @default(cuid())
    debitAccountId  String?
    creditAccountId String?
    amount          Decimal           @db.Decimal(15, 2)
    currency        String
    type            TransactionType
    status          TransactionStatus @default(PENDING)
    description     String?
    reference       String?           @unique
    remittanceId    String?
    metadata        Json?
    createdAt       DateTime          @default(now())
    updatedAt       DateTime          @updatedAt

    // Relations
    debitAccount  Account?    @relation("DebitAccount", fields: [debitAccountId], references: [id])
    creditAccount Account?    @relation("CreditAccount", fields: [creditAccountId], references: [id])
    remittance    Remittance? @relation(fields: [remittanceId], references: [id])

    @@map("transactions")
}

enum TransactionType {
    TRANSFER
    DEPOSIT
    WITHDRAWAL
    FEE
    REFUND
}

enum TransactionStatus {
    PENDING
    COMPLETED
    FAILED
    REVERSED
}

enum KycStatus {
    PENDING
    VERIFIED
    REJECTED
    EXPIRED
}

enum AccountType {
    PERSONAL
    BUSINESS
    MERCHANT
}

enum AccountStatus {
    ACTIVE
    SUSPENDED
    CLOSED
}

enum RemittanceStatus {
    PENDING
    PROCESSING
    COMPLETED
    FAILED
    CANCELLED
    REFUNDED
}
