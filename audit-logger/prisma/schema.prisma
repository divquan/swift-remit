generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model audit_logs {
  id           String    @id @default(uuid())
  userId       String?
  remittanceId String?
  action       String
  resource     String
  details      Json
  ipAddress    String?
  userAgent    String?
  service      String?
  level        String    @default("INFO")
  timestamp    DateTime  @default(now())
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([remittanceId])
  @@index([action])
  @@index([resource])
  @@index([service])
  @@index([timestamp])
  @@index([createdAt])
}
