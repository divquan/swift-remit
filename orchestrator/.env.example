# Environment Configuration
NODE_ENV=development
PORT=3002

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/swiftremit"

# Redis
REDIS_URL="redis://localhost:6379"

# Payment Providers
MOCK_PAYMENT_PROVIDER_URL="http://localhost:3003"

# Audit Logger
AUDIT_LOGGER_URL="http://localhost:3004"

# Logging
LOG_LEVEL=info

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY_MS=1000
RETRY_BACKOFF_FACTOR=2

# Queue Configuration
QUEUE_CONCURRENCY=5
QUEUE_MAX_STALLED_COUNT=3
QUEUE_STALLED_INTERVAL=30000

# Transaction Timeouts
PAYMENT_TIMEOUT_MS=30000
DB_TRANSACTION_TIMEOUT_MS=10000
