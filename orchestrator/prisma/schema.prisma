generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model accounts {
  id                                                  String         @id
  userId                                              String
  accountType                                         AccountType    @default(PERSONAL)
  currency                                            String         @default("GHS")
  status                                              AccountStatus  @default(ACTIVE)
  createdAt                                           DateTime       @default(now())
  updatedAt                                           DateTime
  balance                                             Decimal        @default(0) @db.Decimal(15, 2)
  users                                               users          @relation(fields: [userId], references: [id], onDelete: Cascade)
  remittances_remittances_senderAccountIdToaccounts   remittances[]  @relation("remittances_senderAccountIdToaccounts")
  remittances_remittances_receiverAccountIdToaccounts remittances[]  @relation("remittances_receiverAccountIdToaccounts")
  transactions_transactions_creditAccountIdToaccounts transactions[] @relation("transactions_creditAccountIdToaccounts")
  transactions_transactions_debitAccountIdToaccounts  transactions[] @relation("transactions_debitAccountIdToaccounts")
}

model api_keys {
  id          String    @id
  name        String
  keyHash     String    @unique
  permissions Json
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  expiresAt   DateTime?
}

model audit_logs {
  id           String       @id
  userId       String?
  remittanceId String?
  action       String
  resource     String
  details      Json
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime     @default(now())
  level        String       @default("INFO")
  service      String?
  timestamp    DateTime     @default(now())
  remittances  remittances? @relation(fields: [remittanceId], references: [id])
  users        users?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([remittanceId])
  @@index([action])
  @@index([resource])
  @@index([service])
  @@index([level])
  @@index([timestamp])
}

model exchange_rates {
  id           String   @id
  fromCurrency String
  toCurrency   String
  rate         Decimal  @db.Decimal(10, 6)
  provider     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime

  @@unique([fromCurrency, toCurrency])
}

model remittances {
  id                                               String           @id
  idempotencyKey                                   String           @unique
  senderAccountId                                  String
  receiverAccountId                                String?
  receiverDetails                                  Json
  amount                                           Decimal          @db.Decimal(15, 2)
  currency                                         String
  exchangeRate                                     Decimal?         @db.Decimal(10, 6)
  convertedAmount                                  Decimal?         @db.Decimal(15, 2)
  convertedCurrency                                String?
  fee                                              Decimal          @db.Decimal(15, 2)
  status                                           RemittanceStatus @default(PENDING)
  paymentProvider                                  String?
  providerTxnId                                    String?
  failureReason                                    String?
  metadata                                         Json?
  createdAt                                        DateTime         @default(now())
  updatedAt                                        DateTime
  completedAt                                      DateTime?
  audit_logs                                       audit_logs[]
  accounts_remittances_senderAccountIdToaccounts   accounts         @relation("remittances_senderAccountIdToaccounts", fields: [senderAccountId], references: [id], map: "fk_remittance_senderAccountId")
  accounts_remittances_receiverAccountIdToaccounts accounts?        @relation("remittances_receiverAccountIdToaccounts", fields: [receiverAccountId], references: [id])
  transactions                                     transactions[]
}

model transactions {
  id                                              String            @id
  debitAccountId                                  String?
  creditAccountId                                 String?
  amount                                          Decimal           @db.Decimal(15, 2)
  currency                                        String
  type                                            TransactionType
  status                                          TransactionStatus @default(PENDING)
  description                                     String?
  reference                                       String?           @unique
  remittanceId                                    String?
  metadata                                        Json?
  createdAt                                       DateTime          @default(now())
  updatedAt                                       DateTime
  accounts_transactions_creditAccountIdToaccounts accounts?         @relation("transactions_creditAccountIdToaccounts", fields: [creditAccountId], references: [id])
  accounts_transactions_debitAccountIdToaccounts  accounts?         @relation("transactions_debitAccountIdToaccounts", fields: [debitAccountId], references: [id])
  remittances                                     remittances?      @relation(fields: [remittanceId], references: [id])
}

model users {
  id            String       @id
  email         String       @unique
  password      String
  firstName     String
  lastName      String
  phoneNumber   String?
  countryCode   String       @default("GH")
  kycStatus     KycStatus    @default(PENDING)
  isActive      Boolean      @default(true)
  emailVerified Boolean      @default(false)
  phoneVerified Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime
  lastLoginAt   DateTime?
  accounts      accounts[]
  audit_logs    audit_logs[]
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum AccountType {
  PERSONAL
  BUSINESS
  MERCHANT
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum RemittanceStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum TransactionType {
  TRANSFER
  DEPOSIT
  WITHDRAWAL
  FEE
  REFUND
}
